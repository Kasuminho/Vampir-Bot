{
  "name": "vampir-tactical-overlay-client",
  "version": "1.0.0",
  "description": "Windows Transparent Desktop Overlay for Vampir Alliance",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.vampir.overlay",
    "productName": "VampirOverlay",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "VampirOverlay.exe"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
